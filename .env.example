# 환경변수 예시 — 모두 선택입니다. 키가 없어도 규칙 해석·분석·보고서·반출 묶음은 모두 동작합니다.
# 실제 값은 이 파일을 .env로 복사해 채우거나, 운영자 페이지(http://localhost:8501/admin)에서 입력하세요.
# .env와 운영자 설정 파일(config/local_settings.json)은 저장소·제출물에 들어가지 않습니다.

# AI(선택): 질문 해석·지원사업 자격 대조. 모델은 gpt-6-luna 고정, 월 한도 $10(운영자 페이지에서 변경)
OPENAI_API_KEY=
# OpenAI 호환 API를 쓸 때만
# OPENAI_BASE_URL=https://api.openai.com/v1

# 제주데이터허브 Open API 프로젝트키(선택): 공개 데이터 597을 새로 받을 때. 없으면 동봉 파일 사용
JEJUDATAHUB_APP_KEY=

# 공공데이터포털 인증키(선택): K-Startup·기업마당 지원사업 실시간 조회, 관광공사 방문자 수·행안부 인구 새로 받기
# (활용신청한 계정의 일반 인증키). 없으면 지원사업은 마지막 저장본, 방문자 수·인구는 동봉 파일 사용
DATA_GO_KR_KEY=
# K-Startup만 다른 키를 쓸 때(없으면 DATA_GO_KR_KEY)
# KSTARTUP_SERVICE_KEY=

# 공개 데모로 띄울 때 1: 운영자 페이지를 닫습니다(센터 설치본에서는 비워 둠)
# JEJU_AGENT_DEMO=1
